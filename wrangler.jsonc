{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imper-marketing",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "imper.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
